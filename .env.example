# Text analysis provider. Uses an existing local subscription login.
LLM_PROVIDER=codex
LLM_FALLBACK_PROVIDERS=claude
# CODEX_MODEL=
# CLAUDE_MODEL=
# CLAUDE_CODE_OAUTH_TOKEN=  # For unattended Claude Agent SDK runs.

# Telegram moderation and destination channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_CHANNEL_ID=
ENABLE_TELEGRAM_APPROVAL=true
# 0 means wait indefinitely. Positive values reject on timeout.
TELEGRAM_TIMEOUT_MINUTES=0

# Auto-post policy.
ENABLE_HYBRID_AUTO_POSTING=true
MIN_POST_SCORE_FOR_AUTO=80
MAX_AUTO_POSTS_PER_DAY=1
MIN_POST_INTERVAL_MINUTES=30
AUTO_QUEUE_TTL_HOURS=24

# Prefer article OpenGraph images during the first phase.
ENABLE_IMAGE_GEN=false

# Optional paid fallback.
# GEMINI_KEY=
# GEMINI_MODEL=models/gemini-2.5-flash-lite

# Disable legacy social networks unless explicitly configured.
ENABLE_INTERACTIONS=false
ENABLE_BIO_MGMT=false

# YouTube discovery engine (optional, for video-layer factory build).
# YOUTUBE_API_KEY=
# YOUTUBE_REGION_CODES=RU,UA,US,DE,IN,BR
# YOUTUBE_LANGUAGE_HINTS=ru,en
# YOUTUBE_SEED_QUERIES=Claude Code,OpenAI Codex,AI agents MCP,n8n automation
